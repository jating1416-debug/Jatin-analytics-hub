generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(ADMIN)
  articles  Article[]
  createdAt DateTime  @default(now())
}

enum Role {
  ADMIN
  AUTHOR
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  color       String?
  articles    Article[]
  createdAt   DateTime  @default(now())
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  slug     String       @unique
  articles ArticleTag[]
}

model Article {
  id              Int          @id @default(autoincrement())
  title           String
  slug            String       @unique
  excerpt         String?
  content         String       @db.Text // HTML content (Blogger jaisa)
  contentType     ContentType  @default(TUTORIAL)
  difficulty      Difficulty   @default(BEGINNER)
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  canonicalUrl    String?
  coverImage      String?
  readingTime     Int?
  category        Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId      Int
  tags            ArticleTag[]
  author          User         @relation(fields: [authorId], references: [id])
  authorId        String
  viewCount       Int          @default(0)
  likeCount       Int          @default(0)
  status          Status       @default(PUBLISHED)
  featured        Boolean      @default(false)
  scheduledAt     DateTime?
  noindex         Boolean      @default(false)
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  comments        Comment[]
  revisions       ArticleRevision[]
  series          ArticleSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesId        Int?
  seriesOrder     Int?

  @@index([slug])
  @@index([categoryId, status, publishedAt])
  @@index([status, publishedAt])
  @@index([viewCount])
}

model ArticleTag {
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     Int

  @@id([articleId, tagId])
}

enum ContentType {
  TUTORIAL
  HANDBOOK
  ERROR_FIX
  COMPARISON
  INTERVIEW_QA
  CHEAT_SHEET
  CASE_STUDY
  CAREER
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Status {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model Download {
  id            Int      @id @default(autoincrement())
  title         String
  description   String?
  fileUrl       String
  fileType      String
  fileSize      String?
  thumbnail     String?
  category      String
  downloadCount Int      @default(0)
  isFree        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Tool {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  category    String
  usageCount  Int      @default(0)
  isActive    Boolean  @default(true)
}

model Comment {
  id        Int      @id @default(autoincrement())
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  name      String
  content   String   @db.Text
  likes     Int      @default(0)
  status    String   @default("approved") // approved | pending | spam
  createdAt DateTime @default(now())

  @@index([articleId])
  @@index([status])
}

model PageView {
  id        Int      @id @default(autoincrement())
  path      String
  articleId Int?
  sessionId String
  userAgent String?
  referer   String?
  country   String?
  device    String?
  duration  Int?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

model SearchLog {
  id        Int      @id @default(autoincrement())
  term      String
  createdAt DateTime @default(now())

  @@index([term])
  @@index([createdAt])
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text // JSON
}

model Page {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  content   String   @db.Text
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArticleRevision {
  id        Int      @id @default(autoincrement())
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  excerpt   String?
  createdAt DateTime @default(now())

  @@index([articleId])
}

model ArticleSeries {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  description String?
  articles    Article[]
  createdAt   DateTime  @default(now())
}
